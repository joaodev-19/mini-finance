<% content_for :title, "#{@entry.title} | Mini Finance" %>

<main class="app-notebook app-notebook-show" aria-labelledby="entry-title">
  <% if notice.present? %>
    <p class="app-notebook-notice" role="status"><i class="bi bi-check-circle" aria-hidden="true"></i> <%= notice %></p>
  <% end %>
  <div class="app-notebook-paper">
    <header class="app-notebook-form-heading">
      <p class="app-notebook-eyebrow app-paper-label">Detalhes do lançamento</p>
      <h1 id="entry-title"><%= @entry.title %></h1>
    </header>

    <dl class="app-notebook-details">
      <div>
        <dt>Tipo do lançamento</dt>
        <dd><%= entry_kind_label(@entry) %></dd>
      </div>
      <div>
        <dt>Valor</dt>
        <dd class="app-note-entry-amount <%= entry_amount_class(@entry) %>">
          <%= "+" if @entry.income? %><%= "-" if @entry.expense? %>
          <%= number_to_currency(@entry.amount, unit: "R$ ", separator: ",", delimiter: ".") %>
        </dd>
      </div>
      <div>
        <dt>Categoria</dt>
        <dd><%= category_icon(@entry.category) %> <%= @entry.category&.name || "Sem categoria" %></dd>
      </div>
      <div>
        <dt>Data do lançamento</dt>
        <dd>
          <% if @entry.occurred_on.present? %>
            <time datetime="<%= @entry.occurred_on.iso8601 %>"><%= @entry.occurred_on.strftime("%d/%m/%Y") %></time>
          <% else %>
            Não informada
          <% end %>
        </dd>
      </div>
      <div class="app-notebook-field-wide">
        <dt>Descrição</dt>
        <dd class="app-notebook-description"><%= @entry.description.presence || "Sem descrição." %></dd>
      </div>
    </dl>

    <div class="app-notebook-form-actions app-notebook-entry-actions">
      <%= link_to entries_path, class: "app-notebook-detail app-back-marker" do %>
        <span class="app-action-content"><i class="bi bi-arrow-left" aria-hidden="true"></i> Voltar aos lançamentos</span>
      <% end %>
      <div class="app-notebook-entry-action-buttons">
          <button
            type="button"
            class="app-notebook-delete app-delete-sticker"
            data-bs-toggle="modal"
            data-bs-target="#deleteEntryModal"
            data-category-name="<%= @entry.title %>"
            data-delete-url="<%= entries_path(@entry) %>"
            >
              <span class="app-action-content"><span class="app-paper-cross" aria-hidden="true">×</span> Excluir</span>
          </button>

        <%= link_to edit_entry_path(@entry), class: "app-notebook-button app-writing-action app-paper-action app-paper-action--write" do %>
          <span class="app-action-content"><i class="bi bi-pencil" aria-hidden="true"></i> Editar</span>
        <% end %>
      </div>
    </div>
  </div>
</main>

<%= render "shared/delete_modal",
    record: @entry,
    modal_id: "deleteEntryModal",
    label: "lançamento",
    name: @entry.title %>
