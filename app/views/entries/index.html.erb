<% content_for :title, "Meu caderno de lançamentos | Mini Finance" %>
<% content_for :body_class, "app-notebook-listing" %>

<main class="app-notebook app-notebook-index" aria-labelledby="notebook-title"
      data-controller="notebook-pagination" data-notebook-pagination-per-page-value="<%= @pagination.per_page %>"
      data-notebook-pagination-page-value="<%= @pagination.page %>">
  <header class="app-notebook-header">
    <div>
      <p class="app-notebook-eyebrow"><i class="bi bi-journal-text" aria-hidden="true"></i> Mini Finance / meu caderno</p>
      <h1 id="notebook-title">Lançamentos<span aria-hidden="true">.</span></h1>
      <p class="app-notebook-subtitle">As contas do dia a dia, uma anotação de cada vez.</p>
    </div>
    <%= link_to new_entry_path, class: "app-notebook-button app-paper-action" do %>
      <span class="app-action-content"><i class="bi bi-file-earmark-plus" aria-hidden="true"></i> Novo lançamento</span>
    <% end %>
  </header>

  <% if notice.present? %>
    <p class="app-notebook-notice" role="status"><i class="bi bi-check-circle" aria-hidden="true"></i> <%= notice %></p>
  <% end %>

  <section class="app-notebook-paper" aria-labelledby="notebook-notes-title">
    <div class="app-notebook-section-heading app-notebook-entries-heading">
      <h2 id="notebook-notes-title">Minhas anotações</h2>
      <div class="app-notebook-heading-actions">
        <span class="app-notebook-entry-count app-paper-label"><%= pluralize(@pagination.total_count, "lançamento", plural: "lançamentos") %></span>
        <details class="app-notebook-filter-disclosure" data-controller="filter-panel"
                 data-action="toggle->filter-panel#fit resize@window->filter-panel#fit keydown.esc->filter-panel#close click@window->filter-panel#dismiss">
          <% active_filter_count = [params[:search], params[:category], params[:kind]].count(&:present?) %>
          <summary id="entry-filters-toggle" class="app-notebook-filter-toggle app-paper-action app-paper-action--filter"
                   aria-controls="entry-filters-menu">
            <span class="app-action-content"><i class="bi bi-sliders" aria-hidden="true"></i>
              Filtros<%= " (#{active_filter_count})" if active_filter_count.positive? %></span>
          </summary>
          <div id="entry-filters-menu" class="app-notebook-filter-menu app-paper-note" aria-labelledby="entry-filters-toggle">
            <%= form_with url: entries_path, method: :get, class: "app-notebook-filters" do |form| %>
              <%= form.hidden_field :per_page, value: @pagination.per_page, id: nil %>
              <div class="app-notebook-filter-field">
                <%= form.label :search, "Pesquisar lançamento", class: "form-label" %>
                <div class="app-notebook-filter-search">
                  <i class="bi bi-search" aria-hidden="true"></i>
                  <%= form.text_field :search,
                      class: "form-control",
                      placeholder: "Ex.: Supermercado",
                      value: params[:search] %>
                </div>
              </div>
              <div class="app-notebook-filter-field">
                <%= form.label :category, "Categoria", class: "form-label" %>
                <%= form.collection_select :category, @categories, :id, :name,
                    { include_blank: "Todas", selected: params[:category] },
                    { class: "form-select" } %>
              </div>
              <div class="app-notebook-filter-field">
                <%= form.label :kind, "Tipo de lançamento", class: "form-label" %>
                <%= form.select :kind, entry_kind_options,
                    { include_blank: "Todos", selected: params[:kind] },
                    { class: "form-select" } %>
              </div>
              <div class="app-notebook-filter-actions">
                <%= link_to "Limpar filtros", entries_path, class: "app-notebook-filter-clear" %>
                <%= form.submit "Aplicar", class: "app-notebook-button app-save-stamp app-save-stamp--compact", data: { turbo_submits_with: "Aplicando…" } %>
              </div>
            <% end %>
          </div>
        </details>
      </div>
    </div>
    <div id="entries" class="app-notebook-entries app-notebook-page-rows" data-notebook-pagination-target="rows"
         role="region" aria-labelledby="notebook-notes-title" tabindex="0">
      <% if @entries.any? %>
        <% @entries.each do |entry| %>
          <div class="app-notebook-row">
            <%= render entry %>

            <%= link_to entry_path(entry, notebook_context_params), class: "app-notebook-detail app-sticker app-sticker--open",
                aria: { label: "Abrir lançamento: #{entry.title}" } do %>
              <span class="app-action-content"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Abrir</span>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="app-notebook-empty app-paper-note">
          <% if [params[:search], params[:category], params[:kind]].any?(&:present?) %>
            <i class="bi bi-search" aria-hidden="true"></i>
            <h3>Nenhum lançamento encontrado</h3>
            <p>Tente selecionar outros filtros.</p>
            <%= link_to "Limpar filtros", entries_path, class: "app-notebook-detail" %>
          <% else %>
            <i class="bi bi-pencil-square" aria-hidden="true"></i>
            <h3>Uma página em branco</h3>
            <p>Seu primeiro lançamento começa este caderno.</p>
          <% end %>
        </div>
      <% end %>
    </div>
    <%= render "shared/notebook_pagination", pagination: @pagination, label: "lançamentos" %>
  </section>
</main>
