<% content_for :title, "Meu caderno de lançamentos | Mini Finance" %>

<main class="app-notebook" aria-labelledby="notebook-title">
  <header class="app-notebook-header">
    <div>
      <p class="app-notebook-eyebrow"><i class="bi bi-journal-text" aria-hidden="true"></i> Mini Finance / meu caderno</p>
      <h1 id="notebook-title">Lançamentos<span aria-hidden="true">.</span></h1>
      <p class="app-notebook-subtitle">As contas do dia a dia, uma anotação de cada vez.</p>
    </div>
    <%= link_to new_entry_path, class: "app-notebook-button" do %>
      <i class="bi bi-plus-lg" aria-hidden="true"></i> Novo lançamento
    <% end %>
  </header>

  <% if notice.present? %>
    <p class="app-notebook-notice" role="status"><i class="bi bi-check-circle" aria-hidden="true"></i> <%= notice %></p>
  <% end %>

  <section class="app-notebook-paper" aria-labelledby="notebook-notes-title">
    <div class="app-notebook-section-heading app-notebook-entries-heading">
      <h2 id="notebook-notes-title">Minhas anotações</h2>
      <div class="app-notebook-heading-actions">
        <span class="app-notebook-entry-count"><%= pluralize(@entries.size, "lançamento", plural: "lançamentos") %></span>
        <div class="dropdown">
          <% active_filter_count = [params[:category], params[:kind]].count(&:present?) %>
          <button type="button" id="entry-filters-toggle" class="app-notebook-filter-toggle dropdown-toggle"
                  data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-controls="entry-filters-menu">
            <i class="bi bi-sliders" aria-hidden="true"></i>
            Filtros<%= " (#{active_filter_count})" if active_filter_count.positive? %>
          </button>
          <div id="entry-filters-menu" class="dropdown-menu dropdown-menu-end app-notebook-filter-menu" aria-labelledby="entry-filters-toggle">
            <%= form_with url: entries_path, method: :get, class: "app-notebook-filters" do |form| %>
              <div class="app-notebook-filter-field">
                <%= form.label :category, "Categoria", class: "form-label" %>
                <%= form.collection_select :category, @categories, :id, :name,
                    { include_blank: "Todas", selected: params[:category] },
                    { class: "form-select" } %>
              </div>
              <div class="app-notebook-filter-field">
                <%= form.label :kind, "Tipo de lançamento", class: "form-label" %>
                <%= form.select :kind, entry_kind_options,
                    { include_blank: "Todos", selected: params[:kind] },
                    { class: "form-select" } %>
              </div>
              <div class="app-notebook-filter-actions">
                <%= link_to "Limpar filtros", entries_path, class: "app-notebook-filter-clear" %>
                <%= form.submit "Aplicar", class: "app-notebook-button", data: { turbo_submits_with: "Aplicando…" } %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <div id="entries" class="app-notebook-entries">
      <% if @entries.any? %>
        <% @entries.each do |entry| %>
          <div class="app-notebook-row">
            <%= render entry %>

            <%= link_to entry, class: "app-notebook-detail",
                aria: { label: "Ver lançamento: #{entry.title}" } do %>
              Ver <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="app-notebook-empty">
          <% if params[:category].present? || params[:kind].present? %>
            <i class="bi bi-search" aria-hidden="true"></i>
            <h3>Nenhum lançamento encontrado</h3>
            <p>Tente selecionar outros filtros.</p>
            <%= link_to "Limpar filtros", entries_path, class: "app-notebook-detail" %>
          <% else %>
            <i class="bi bi-pencil-square" aria-hidden="true"></i>
            <h3>Uma página em branco</h3>
            <p>Seu primeiro lançamento começa este caderno.</p>
          <% end %>
        </div>
      <% end %>
    </div>
    <footer class="app-notebook-paper-footer">
      <span>Pequenas anotações, mais clareza.</span>
      <i class="bi bi-pencil" aria-hidden="true"></i>
    </footer>
  </section>
</main>
