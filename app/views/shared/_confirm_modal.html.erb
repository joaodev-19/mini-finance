<div class="modal" tabindex="-1" id="deleteModal" aria-labelledby="delete-category-title" aria-describedby="delete-category-description">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <p class="app-notebook-eyebrow" aria-hidden="true">Meu caderno / confirmação</p>
          <h2 class="modal-title" id="delete-category-title">Excluir categoria?</h2>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <div class="app-notebook-confirm-category">
          <i class="bi bi-tag" aria-hidden="true"></i>
          <strong data-delete-name=""></strong>
        </div>
        <p id="delete-category-description">Essa categoria será removida do seu caderno. Esta ação não poderá ser desfeita.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>

        <%= button_to "#",
            method: :delete,
            form: {
                id: "delete-category-form"
            },
            class: "app-notebook-delete",
            disabled: true do %>
          <i class="bi bi-trash" aria-hidden="true"></i> Excluir categoria
        <% end %>
      </div>
    </div>
  </div>
</div>
