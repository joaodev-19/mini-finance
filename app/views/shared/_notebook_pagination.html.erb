<nav class="app-notebook-pagination" aria-label="Paginação de <%= label %>">
  <p class="app-notebook-pagination-summary" role="status">
    <%= pagination.first_item %>–<%= pagination.last_item %> de <%= pagination.total_count %> <%= label %>
  </p>
  <ol class="app-notebook-pagination-pages">
    <li>
      <% if pagination.page > 1 %>
        <%= link_to notebook_page_path(pagination, pagination.page - 1), class: "app-notebook-page app-notebook-page-turn", rel: "prev", aria: { label: "Página anterior" } do %>
          <i class="bi bi-arrow-left" aria-hidden="true"></i>
        <% end %>
      <% else %>
        <span class="app-notebook-page app-notebook-page-turn" aria-disabled="true" aria-label="Página anterior"><i class="bi bi-arrow-left" aria-hidden="true"></i></span>
      <% end %>
    </li>
    <% pagination.page_numbers.each do |number| %>
      <li class="app-notebook-pagination-number<%= ' app-notebook-pagination-number-current' if number == pagination.page %>">
        <% if number.nil? %>
          <span class="app-notebook-page-gap" aria-hidden="true">…</span>
        <% elsif number == pagination.page %>
          <span class="app-notebook-page app-notebook-page-current" aria-current="page" aria-label="Página <%= number %>, atual"><%= number %></span>
        <% else %>
          <%= link_to number, notebook_page_path(pagination, number), class: "app-notebook-page", aria: { label: "Página #{number}" } %>
        <% end %>
      </li>
    <% end %>
    <li>
      <% if pagination.page < pagination.total_pages %>
        <%= link_to notebook_page_path(pagination, pagination.page + 1), class: "app-notebook-page app-notebook-page-turn", rel: "next", aria: { label: "Próxima página" } do %>
          <i class="bi bi-arrow-right" aria-hidden="true"></i>
        <% end %>
      <% else %>
        <span class="app-notebook-page app-notebook-page-turn" aria-disabled="true" aria-label="Próxima página"><i class="bi bi-arrow-right" aria-hidden="true"></i></span>
      <% end %>
    </li>
  </ol>
  <span class="app-notebook-page-caption">folha <%= pagination.page.to_s.rjust(2, "0") %> / <%= pagination.total_pages.to_s.rjust(2, "0") %></span>
</nav>
