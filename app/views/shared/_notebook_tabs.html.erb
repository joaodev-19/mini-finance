<nav class="app-notebook-tabs" aria-label="Seções do caderno">
  <ul class="app-notebook-tabs-list">
    <% [["Lançamentos", entries_path, "entries"], ["Categorias", categories_path, "categories"]].each do |label, path, section| %>
      <li>
        <%= link_to label, path,
            class: "app-notebook-tab#{' app-notebook-tab-active' if controller_name == section}",
            aria: { current: ("page" if controller_name == section) } %>
      </li>
    <% end %>
    <li>
      <span class="app-notebook-tab app-notebook-tab-future" aria-disabled="true">
        Dashboard <small>Em breve</small>
      </span>
    </li>
  </ul>
</nav>
