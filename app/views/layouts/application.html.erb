<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Mini Finance" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mini Finance">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= favicon_link_tag 'icon.svg' %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-paper-desk <%= content_for(:body_class) %>">
    <div class="container app-notebook-desk">
      <div class="app-notebook-shell">
        <%= render "shared/notebook_tabs" %>
        <div class="app-notebook-sheet">
          <%= yield %>
        </div>
      </div>
    </div>
  </body>
</html>
