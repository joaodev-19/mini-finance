<%= form_with(model: category) do |form| %>
  <% if category.errors.any? %>
    <div class="app-notebook-errors" role="alert">
      <p>Confira os dados antes de salvar:</p>

      <ul>
        <% category.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="app-notebook-fields">
    <div class="app-notebook-field app-notebook-field-wide">
      <%= form.label :name, "Nome da categoria", class: "form-label" %>
      <%= form.text_field :name, class: "form-control", placeholder: "Ex.: Alimentação",
          aria: { describedby: "category-name-help" } %>
      <p id="category-name-help" class="app-notebook-field-help">
        <%= category.persisted? ? "Ajuste o nome do lançamento para mantê-lo fácil de reconhecer." : "Escolha um nome fácil de reconhecer ao registrar um lançamento." %> 
      </p>
    </div>
  </div>

  <div class="app-notebook-form-actions justify-content-end">
    <%= form.submit category.persisted? ? "Salvar alterações" : "Adicionar categoria",
        class: "app-notebook-button app-save-stamp", data: { turbo_submits_with: "Salvando…" } %>
  </div>
<% end %>
