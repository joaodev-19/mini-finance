<%= form_with(model: category) do |form| %>
  <% if category.errors.any? %>
    <div class="app-notebook-errors" role="alert">
      <p>Confira os dados antes de salvar:</p>

      <ul>
        <% category.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="app-notebook-fields">
    <div class="app-notebook-field app-notebook-field-wide">
      <%= form.label :name, "Nome da categoria", class: "form-label" %>
      <%= form.text_field :name, class: "form-control", placeholder: "Ex.: Alimentação", required: true,
          aria: { describedby: "category-name-help" } %>
      <p id="category-name-help" class="app-notebook-field-help">
        <%= category.persisted? ? "Ajuste o nome da categoria para mantê-lo fácil de reconhecer." : "Escolha um nome fácil de reconhecer ao registrar um lançamento." %>
      </p>
    </div>
  </div>

  <div class="app-notebook-form-actions justify-content-end">
    <% submit_label = category.persisted? ? "Salvar alterações" : "Adicionar categoria" %>
    <%= form.button type: "submit", name: "commit", value: submit_label,
        class: "app-notebook-button app-save-stamp app-save-stamp--record", data: { turbo_submits_with: "Salvando…" } do %>
      <span class="app-save-seal" aria-hidden="true"><i class="bi bi-check2"></i></span> <%= submit_label %>
    <% end %>
  </div>
<% end %>
