<% content_for :title, "Editar categoria | Mini Finance" %>


<main class="app-notebook app-notebook-show" aria-labelledby="edit-category-title">
  <nav class="app-notebook-category-back" aria-label="Retorno às categorias">
    <%= link_to categories_path, class: "app-notebook-detail app-notebook-back-link" do %>
      <i class="bi bi-arrow-left" aria-hidden="true"></i> Voltar às categorias
    <% end %>
  </nav>

  <section class="app-notebook-paper" aria-labelledby="edit-category-title">
    <header class="app-notebook-form-heading">
      <p class="app-notebook-eyebrow"><i class="bi bi-tags" aria-hidden="true"></i> No meu caderno</p>
      <h1 id="new-category-title">Editar categoria</h1>
      <p class="app-notebook-subtitle">Administre uma divisória para organizar seus lançamentos.</p>
    </header>

    <%= render "form", category: @category %>
  </section>
</main>
