<% content_for :title, "Categorias | Mini Finance" %>

<main class="app-notebook app-notebook-categories" aria-labelledby="categories-title">
  <header class="app-notebook-header">
    <div>
      <p class="app-notebook-eyebrow"><i class="bi bi-tags" aria-hidden="true"></i> Mini Finance / meu caderno</p>
      <h1 id="categories-title">Categorias<span aria-hidden="true">.</span></h1>
      <p class="app-notebook-subtitle">Um lugar para cada tipo de anotação.</p>
    </div>
    <%= link_to new_category_path, class: "app-notebook-button app-paper-action " do %>
      <span class="app-action-content"><i class="bi bi-folder-plus" aria-hidden="true"></i> Adicionar categoria</span>
    <% end %>
  </header>

  <% if notice.present? %>
    <p class="app-notebook-notice" role="status"><i class="bi bi-check-circle" aria-hidden="true"></i> <%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p class="app-notebook-errors" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> <%= alert %></p>
  <% end %>

  <section class="app-notebook-paper" aria-labelledby="categories-list-title">
    <div class="app-notebook-section-heading">
      <h2 id="categories-list-title">As divisórias do caderno</h2>
      <span class="app-paper-label"><%= pluralize(@categories.size, "categoria", plural: "categorias") %></span>
    </div>
    <div id="categories" class="app-notebook-category-list" role="region" aria-labelledby="categories-list-title">
      <% if @categories.any? %>
        <% @categories.each do |category| %>
          <div class="app-notebook-category-row">
            <%= render category %>
            <div class="app-notebook-category-actions">
              <%= link_to category, class: "app-notebook-detail app-sticker app-sticker--open", aria: { label: "Abrir categoria #{category.name}" } do %>
                <span class="app-action-content"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Abrir</span>
              <% end %>

              <button 
                type="button" 
                class="app-notebook-delete app-sticker app-sticker--danger"
                data-bs-toggle="modal" 
                data-bs-target="#deleteCategoryModal"
                data-category-name="<%= category.name %>"
                data-delete-url="<%= category_path(category) %>"
                >
                  <span class="app-action-content"><span class="app-paper-cross" aria-hidden="true">×</span> Excluir</span>
              </button>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="app-notebook-empty app-paper-note">
          <i class="bi bi-tags" aria-hidden="true"></i>
          <h3>Cada anotação no seu lugar</h3>
          <p>Adicione sua primeira categoria para organizar os lançamentos.</p>
        </div>
      <% end %>
    </div>
    <footer class="app-notebook-paper-footer">
      <span>Um caderno organizado começa pelos detalhes.</span>
      <i class="bi bi-bookmark" aria-hidden="true"></i>
    </footer>
  </section>
</main>

<script>
  document.addEventListener("show.bs.modal", (e) => {
    const modal = e.target;

    if (modal.id !== "deleteCategoryModal") return;

    const trigger = event.relatedTarget;
    if (!trigger) return;

    const name = trigger.dataset.categoryName;
    const deleteUrl = trigger.dataset.deleteUrl;

    const form = modal.querySelector("#delete-category-form");
    const confirmButton = form?.querySelector(".app-notebook-delete");
    const nameElement = modal.querySelector("[data-delete-name]");

    if (!form || !confirmButton || !nameElement || !deleteUrl) return;

    nameElement.textContent = name;
    form.action = deleteUrl;
    confirmButton.disabled = false;
  });
</script>

<%= render "shared/delete_modal",
    modal_id: "deleteCategoryModal",
    label: "categoria" %>
