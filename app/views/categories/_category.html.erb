<article id="<%= dom_id category %>" class="app-notebook-category" aria-labelledby="<%= dom_id(category, :name) %>">
  <span class="app-notebook-category-icon" aria-hidden="true"><%= category_icon(category) %></span>
  <div class="app-notebook-category-content">
    <p class="app-note-entry-category">Categoria</p>
    <h3 id="<%= dom_id(category, :name) %>" class="app-note-entry-title"><%= category.name %></h3>
  </div>
</article>
